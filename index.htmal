<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VideoToolHub - Free Video Tools</title>
<meta name="description" content="Free online video tools. View YouTube thumbnails and preview your own videos.">
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f4f7fc;color:#17233b}
header{background:#10264b;color:white;padding:22px 7%;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:24px;font-weight:bold}
.hero{text-align:center;padding:65px 20px 35px}
.hero h1{font-size:38px;margin:0 0 15px}
.hero p{color:#65738a}
.tools{max-width:950px;margin:25px auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;padding:15px}
.card{background:white;padding:25px;border-radius:14px;box-shadow:0 4px 18px #17233b12}
.card h3{margin-top:0}
input{width:100%;padding:13px;border:1px solid #ccd5e2;border-radius:8px;margin:12px 0}
button{background:#2563eb;color:white;border:0;padding:12px 18px;border-radius:8px;cursor:pointer}
button:hover{background:#1748bd}
#result img{max-width:100%;margin-top:15px;border-radius:8px}
#preview{max-width:100%;margin-top:12px}
footer{text-align:center;padding:30px;color:#68758a}
</style>
</head>
<body>
<header>
<div class="logo">VideoToolHub</div>
<div>Free Online Video Tools</div>
</header>

<section class="hero">
<h1>Free Video Tools Online</h1>
<p>Simple, useful and free tools for your videos.</p>
</section>

<section class="tools">
<div class="card">
<h3>▶ YouTube Thumbnail Viewer</h3>
<p>View the thumbnail of a YouTube video.</p>
<input id="youtube" placeholder="Paste YouTube video link">
<button onclick="showThumbnail()">View Thumbnail</button>
<div id="result"></div>
</div>

<div class="card">
<h3>🎬 Video Preview</h3>
<p>Preview a video stored on your device.</p>
<input type="file" id="videoFile" accept="video/*">
<video id="preview" controls></video>
</div>

<div class="card">
<h3>📦 Video Tools</h3>
<p>More free video tools are coming soon.</p>
<p>Compress, convert and manage your own videos.</p>
</div>
</section>

<footer>
<p>© 2026 VideoToolHub. All rights reserved.</p>
<p>Use these tools responsibly and respect copyright.</p>
</footer>

<script>
function showThumbnail(){
const link=document.getElementById('youtube').value.trim();
const result=document.getElementById('result');
const match=link.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
if(!match){
result.textContent="Please enter a valid YouTube video link.";
return;
}
const id=match[1];
result.innerHTML="";
const img=document.createElement('img');
img.src="https://img.youtube.com/vi/"+id+"/hqdefault.jpg";
img.alt="YouTube video thumbnail";
result.appendChild(img);
}
document.getElementById('videoFile').addEventListener('change',function(){
const file=this.files[0];
if(file){
document.getElementById('preview').src=URL.createObjectURL(file);
}
});
</script>
</body>
</html>
